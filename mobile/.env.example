# Only needed in production / when testing against a deployed backend.
# In local development, src/api/client.ts derives the API URL from Expo's
# own dev-server host automatically - leave this unset.
EXPO_PUBLIC_API_URL=https://mozarttechniques.com

# Apple sign-in uses this HTTPS backend. Keep APPLE_PRIVATE_KEY and all other
# Apple credentials on the server only; never put them in EXPO_PUBLIC_ variables.
