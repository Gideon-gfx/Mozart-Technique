{
  "expo": {
    "name": "Mozart Techniques",
    "slug": "mozart-techniques",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/mozart-logo.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mozarttechniques.app",
      "infoPlist": {
        "NSCameraUsageDescription": "Allow Mozart Techniques to use your camera for video calls with your tutor/student."
      }
    },
    "android": {
      "package": "com.mozarttechniques.app",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.CAMERA",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "experiments": {
      "baseUrl": "/app"
    },
    "plugins": [
      "expo-font",
[
  "expo-splash-screen",
  {
    "image": "./assets/mozart-logo.png",
    "imageWidth": 56,
    "resizeMode": "contain",
    "backgroundColor": "#FBF7F0",
    "dark": {
      "backgroundColor": "#000000"
    }
  }
],
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.1028023374175-1l8s2ob94li3l8me9f09i5sgsvjnm0b0"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Mozart Techniques to access your photos and videos to share performer portfolios and event requests."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow Mozart Techniques to use your location to show tutors near you."
        }
      ],
      "expo-video",
      "expo-web-browser",
      [
        "expo-audio",
        {
          "microphonePermission": "Allow Mozart Techniques to use your microphone for voice notes and teaching tools such as the tuner and optional dictation."
        }
      ],
      "expo-secure-store",
      "expo-asset",
      [
        "expo-notifications",
        {
          "color": "#cc0000"
        }
      ]
    ],
    "extra": {
      "googleWebClientId": "1028023374175-0obt7er3175l5jp6i9d44sl1elv5sub8.apps.googleusercontent.com",
      "googleIosClientId": "1028023374175-1l8s2ob94li3l8me9f09i5sgsvjnm0b0.apps.googleusercontent.com",
      "googleAndroidClientId": "1028023374175-8ubnccchsh8g4dm2kodg5mlk9296a3t5.apps.googleusercontent.com",
      "eas": {
        "projectId": "d0635679-e3fa-41e1-ab9e-a3c4076e7a02"
      }
    },
    "owner": "gideon-gfx"
  }
}
