# Web client ID - used by the browser sign-in button on /login.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional - native app client IDs. A native app can't use the web client
# ID, but it signs in against this same backend, so the server accepts
# these as valid token audiences too. Leave blank if there's no native app.
GOOGLE_ANDROID_CLIENT_ID=
GOOGLE_IOS_CLIENT_ID=

# Google Calendar / Meet. Defaults to the web client above, which is the
# right choice for a hosted app. Only set these to override with a separate
# OAuth client. Whichever client is used must have the redirect URI below
# registered under its "Authorized redirect URIs" - a "Desktop app" client
# can't do that (loopback only), so don't use one here.
# GOOGLE_CALENDAR_CLIENT_ID=
# GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=http://localhost:3000/api/calendar/callback

# Browser-side Google Maps JS API key. This one is public by design (it
# ships in page source), so restrict it in the Cloud Console by HTTP
# referrer and to just the APIs it needs - that restriction is the only
# thing protecting it from use on other sites.
GOOGLE_MAPS_API_KEY=

# Stripe - test keys (sk_test_/pk_test_) until you're ready to take real
# payments. The secret key must never reach the browser.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=

# Optional - set these to send real email notifications to admins (new
# tutor/student/sponsor requests) in addition to the in-app bell icon.
# Gmail: use an App Password, not your regular password - generate one at
# https://myaccount.google.com/apppasswords (requires 2-Step Verification
# to be enabled on the account first).
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Alternative to the Gmail option above - any generic SMTP provider.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=

SESSION_SECRET=

# MongoDB Atlas persistence. Set this in the hosting provider's secret store;
# do not commit a real URI or password.
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/mozart-technique?retryWrites=true&w=majority
